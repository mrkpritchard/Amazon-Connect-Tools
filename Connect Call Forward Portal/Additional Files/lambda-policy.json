{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "connect:SearchContacts",
        "connect:DescribeContact",
        "connect:ListQueues",
        "connect:DescribeQueue",
        "connect:DescribeUser",
        "connect:ListUsers"
      ],
      "Resource": [
        "arn:aws:connect:us-east-1:YOUR_AWS_ACCOUNT_ID:instance/YOUR_CONNECT_INSTANCE_ID",
        "arn:aws:connect:us-east-1:YOUR_AWS_ACCOUNT_ID:instance/YOUR_CONNECT_INSTANCE_ID/*"
      ]
    }
  ]
}
