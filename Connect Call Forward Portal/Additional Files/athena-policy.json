{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "glue:GetDatabase",
        "glue:GetTable"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::prod-your-org-connect-events-us-east-1-YOUR_AWS_ACCOUNT_ID",
        "arn:aws:s3:::prod-your-org-connect-events-us-east-1-YOUR_AWS_ACCOUNT_ID/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::aws-athena-query-results-us-east-1-YOUR_AWS_ACCOUNT_ID",
        "arn:aws:s3:::aws-athena-query-results-us-east-1-YOUR_AWS_ACCOUNT_ID/*"
      ]
    }
  ]
}
